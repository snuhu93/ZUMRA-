# ZUMRA environment variables
#
# Copy this file to `.env` (same folder) and fill in the values from your
# Supabase project dashboard: Project Settings -> API.
#
# VITE_SUPABASE_URL       -> "Project URL"
# VITE_SUPABASE_ANON_KEY  -> "anon" / "public" key
#
# NEVER put the "service_role" key here or anywhere in frontend code.
# The service-role key is only used server-side, inside
# supabase/functions/delete-account (set via `supabase secrets set`).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
